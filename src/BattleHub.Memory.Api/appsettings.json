{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MemoryDatabase": "Server=(localdb)\\mssqllocaldb;Database=BattleHubMemoryDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Cors": {
    "Origins": [
      "http://localhost:4000",
      "http://localhost:4003"
    ]
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "SampleData": {
    "Enabled": false
  }
}
