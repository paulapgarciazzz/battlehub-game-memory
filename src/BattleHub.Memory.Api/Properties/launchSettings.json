{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "http": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "http://localhost:5095",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ConnectionStrings__MemoryDatabase": "Server=(localdb)\\mssqllocaldb;Database=BattleHubMemoryDb;Trusted_Connection=True;MultipleActiveResultSets=true",
        "Cors__Origins__0": "http://localhost:4000",
        "Cors__Origins__1": "http://localhost:4003",
        "Database__MigrateOnStartup": "true",
        "SampleData__Enabled": "true"
      }
    },
    "https": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "https://localhost:7064;http://localhost:5095",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ConnectionStrings__MemoryDatabase": "Server=(localdb)\\mssqllocaldb;Database=BattleHubMemoryDb;Trusted_Connection=True;MultipleActiveResultSets=true",
        "Cors__Origins__0": "http://localhost:4000",
        "Cors__Origins__1": "http://localhost:4003",
        "Database__MigrateOnStartup": "true",
        "SampleData__Enabled": "true"
      }
    }
  }
}
