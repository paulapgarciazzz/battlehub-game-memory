# Opcional: "docker compose up" funciona sin .env. Para cambiar algún valor,
# copiar a .env (no se sube al repo) y descomentar la línea.

# Contraseña del usuario sa de SQL Server. Si no se define, el compose genera
# una al azar la primera vez y la guarda en el volumen memory-secrets. Debe
# tener 8+ caracteres con mayúsculas, minúsculas y números o símbolos, y no
# puede llevar ";".
# MSSQL_SA_PASSWORD=

# Direcciones que pueden llamar a la API (CORS): el Shell y el microfrontend.
# MEMORY_CORS_SHELL=http://localhost:4000
# MEMORY_CORS_FRONTEND=http://localhost:4003

# Dirección de la API que usa el microfrontend desde el navegador.
# MEMORY_API_URL=http://localhost:5095
