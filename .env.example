# Copiar a .env (no se sube al repo) y cambiar los valores.

# Contraseña del usuario sa de SQL Server. Debe tener 8+ caracteres con
# mayúsculas, minúsculas y números o símbolos, y no puede llevar ";".
MSSQL_SA_PASSWORD=CambiarEsto_123

# Client Secret M2M de Memory para avisar a Matchmaking (opcional).
MATCHMAKING_CLIENT_SECRET=
